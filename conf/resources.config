process {
  // memory amounts are total (per job)

  withLabel: fondue { 
    cpus = 1
    memory = 4.GB * params.overall_mem_scale
    time = { 4.h * params.overall_time_scale * task.attempt }
    clusterOptions = "--tmp=1000G"
  }
  
  withLabel: readSimulation {
    cpus = Math.max(1, (8 * params.overall_cpu_scale * params.cpu_intensive_task_multiplier).round().intValue())
    memory = { 8.GB * params.overall_mem_scale * params.mem_intensive_task_multiplier * task.attempt }
    time = { 4.h * params.overall_time_scale * task.attempt }
  }

  withLabel: fastp {
    cpus = 1
    memory = { (6.GB * params.overall_mem_scale) * task.attempt }
    time = { 1.h * params.overall_time_scale * task.attempt }
  }

  withLabel: sampleFiltering {
    cpus = Math.max(1, (1 * params.overall_cpu_scale).round().intValue())
    memory = { 4.GB * task.attempt }
    time = { 6.h * params.overall_time_scale * task.attempt }
  }
  
  withLabel: hostRemoval {
    cpus = Math.max(1, (4 * params.overall_cpu_scale * params.cpu_intensive_task_multiplier).round().intValue())
    memory = { 8.GB * params.overall_mem_scale * task.attempt }
    time = { 2.h * params.overall_time_scale * task.attempt }
  }

  withLabel: readSubsampling {
    cpus = Math.max(1, (1 * params.overall_cpu_scale).round().intValue())
    memory = { 2.GB * task.attempt }
    time = { 4.h * params.overall_time_scale * task.attempt }
  }

  withLabel: genomeAssembly {
    cpus = Math.max(1, (4 * params.overall_cpu_scale).round().intValue())
    memory = { 12.GB * params.overall_mem_scale * params.mem_intensive_task_multiplier * task.attempt }
    time = { 6.h * params.overall_time_scale * task.attempt }
  }
  
  withLabel: contigEvaluation {
    cpus = Math.max(1, (24 * params.overall_cpu_scale * params.cpu_intensive_task_multiplier).round().intValue())
    memory = { 24.GB * params.overall_mem_scale * Math.pow(2, task.attempt - 1) }
    time = { Math.min(336, (48 * params.overall_time_scale * task.attempt).round().intValue()).h }
  }

  withLabel: indexing {
    cpus = 1
    memory = { 3.GB * params.overall_mem_scale * task.attempt }
    time = { 2.h * params.overall_time_scale * task.attempt }
  }

  withLabel: readMapping {
    cpus = Math.max(1, (4 * params.overall_cpu_scale * params.cpu_intensive_task_multiplier).round().intValue())
    // q2-assembly map-reads buffers the whole SAM output in RAM, so large samples need far more
    // memory than typical ones; double on each retry (high profile: 32 -> 64 -> 128 -> 256 -> 512 GB)
    // task.attempt resets on every restart, so samples in readMappingLargeSamples skip the attempts known to OOM
    // (256 GB -> 1900 GB); they ran past 12 h before dying, so they also need a longer first attempt
    memory = {
      def base = task.tag in params.readMappingLargeSamples.tokenize(',') ? 256.GB : 16.GB * params.overall_mem_scale * params.mem_intensive_task_multiplier
      [base * Math.pow(2, task.attempt - 1), 1900.GB].min()
    }
    time = { (task.tag in params.readMappingLargeSamples.tokenize(',') ? 24.h : 6.h * params.overall_time_scale) * task.attempt }
  }

  // only one sample's BAM per job, unlike the all-sample MAG estimation
  withName: ESTIMATE_SAMPLE_ABUNDANCE {
    clusterOptions = { "--tmp=${Math.min(1000, 200 * task.attempt)}G" }
  }

  // bowtie2-build on the full dereplicated MAG set, not a single sample's contigs
  withName: INDEX_DEREP_MAGS {
    memory = { 32.GB * params.overall_mem_scale * task.attempt }
    time = { 8.h * params.overall_time_scale * task.attempt }
  }

  withLabel: contigBinningMetabat2 {
    cpus = Math.max(1, (2 * params.overall_cpu_scale).round().intValue())
    memory = { 3.GB * params.overall_mem_scale * params.mem_intensive_task_multiplier * task.attempt }
    time = { 4.h * params.overall_time_scale * task.attempt }
  }

  withLabel: contigBinningSemibin2 {
    cpus = Math.max(1, (8 * params.overall_cpu_scale * params.cpu_intensive_task_multiplier).round().intValue())
    memory = { 24.GB * params.overall_mem_scale * params.mem_intensive_task_multiplier * task.attempt }
    time = { 12.h * params.overall_time_scale * task.attempt }
  }

  withLabel: checkm {
    cpus = Math.max(1, (6 * params.overall_cpu_scale).round().intValue())
    memory = { 42.GB * params.overall_mem_scale * task.attempt }
    time = { (6.h * params.overall_time_scale) * task.attempt }
  }
  
  withLabel: busco {
    cpus = Math.max(1, (4 * params.overall_cpu_scale * params.cpu_intensive_task_multiplier).round().intValue())
    memory = { 3.GB * params.overall_mem_scale * task.attempt }
    time = { 4.h * params.overall_time_scale * task.attempt }
  }
  
  withLabel: dereplication {
    cpus = 1
    memory = { 32.GB * params.overall_mem_scale * params.mem_intensive_task_multiplier * Math.pow(2, task.attempt - 1) }
    time = { 12.h * params.overall_time_scale * task.attempt }
  }

  withLabel: abundanceEstimation {
    cpus = Math.max(1, (4 * params.overall_cpu_scale).round().intValue())
    // samtools sort writes each input BAM to the node-local $TMPDIR
    memory = { 24.GB * params.overall_mem_scale * params.mem_intensive_task_multiplier * Math.pow(2, task.attempt - 1) }
    time = { 24.h * params.overall_time_scale * task.attempt }
    clusterOptions = { "--tmp=${Math.min(1000, 500 * task.attempt)}G" }
  }

  withLabel: taxonomicClassification { 
    cpus = Math.max(1, (4 * params.overall_cpu_scale * params.cpu_intensive_task_multiplier).round().intValue())
    memory = { 20.GB * params.overall_mem_scale * params.mem_intensive_task_multiplier * task.attempt }
    time = { 4.h * params.overall_time_scale * task.attempt }
  }

  withLabel: taxonomicClassificationKraken2 { 
    cpus = Math.max(1, (4 * params.overall_cpu_scale * params.cpu_intensive_task_multiplier).round().intValue())
    time = { 4.h * params.overall_time_scale * task.attempt }
  }

  withLabel: taxonomicClassificationKaiju { 
    cpus = Math.max(1, (4 * params.overall_cpu_scale * params.cpu_intensive_task_multiplier).round().intValue())
    time = { 4.h * params.overall_time_scale * task.attempt }
  }

  withLabel: orthologSearch { 
    cpus = Math.max(1, (12 * params.overall_cpu_scale * params.cpu_intensive_task_multiplier).round().intValue())
    time = { 24.h * params.overall_time_scale * task.attempt }
  }

  withLabel: functionalAnnotation {
    cpus = Math.max(1, (4 * params.overall_cpu_scale).round().intValue())
    time = { 24.h * params.overall_time_scale * task.attempt }
    clusterOptions = "--tmp=100G"
  }

  withLabel: humann3Profiling {
    cpus = Math.max(1, (8 * params.overall_cpu_scale * params.cpu_intensive_task_multiplier).round().intValue())
    memory = { (params.humann3.memory_use == 'maximum' ? 64.GB : 24.GB) * params.overall_mem_scale * params.mem_intensive_task_multiplier * task.attempt }
    time = { 24.h * params.overall_time_scale * task.attempt }
  }

  withLabel: humann3Conversion {
    cpus = 1
    memory = { 4.GB * params.overall_mem_scale * task.attempt }
    time = { 2.h * params.overall_time_scale * task.attempt }
  }

  withLabel: collation { 
    cpus = Math.max(1, (1 * params.overall_cpu_scale).round().intValue())
    memory = { 12.GB * params.overall_mem_scale * params.mem_intensive_task_multiplier * task.attempt }
    time = { 24.h * params.overall_time_scale * task.attempt }
    // QIIME 2 copies all collated inputs into the node-local $TMPDIR; grow it on retry
    // 200G was exhausted collating the Kraken2 read outputs (job 17834515); start at 500G, cap at 1000G
    clusterOptions = { "--tmp=${Math.min(1000, 500 * task.attempt)}G" }
  }

  withLabel: needsInternet {
      module  = params.internetModule
  }

}
